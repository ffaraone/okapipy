"""Generated by okapipy — tests for the vendored pagination/filter/sort strategies.

Exercises every built-in strategy in the runtime: encoding shape, count and
random-access capability, error paths. The runtime is copied verbatim into
every generated client, so these tests pin the same behavior here as in
okapipy's own suite. Emitted once and never overwritten.
"""

from __future__ import annotations

import json

import httpx
import pytest

from {{ package }}.base.exceptions import (
    UnsupportedFilterError,
    UnsupportedPaginationError,
    UnsupportedSortError,
)
from {{ package }}.base.filters import Filter, Search
from {{ package }}.base.sort import Sort
from {{ package }}.base.strategies import (
    CommaSignedSort,
    CursorPagination,
    FilterEncoding,
    JsonApiSort,
    JsonFilterStrategy,
    KeyDirectionSort,
    KeyOpValueFilter,
    KeyValueFilter,
    LimitOffsetPagination,
    LinkHeaderPagination,
    PageNumberPagination,
    SearchFilterStrategy,
    SortEncoding,
)


def _response(
    body: dict | list | None = None,
    *,
    headers: dict[str, str] | None = None,
    status_code: int = 200,
) -> httpx.Response:
    """Build a synthetic `httpx.Response` for strategy tests."""
    return httpx.Response(
        status_code=status_code,
        json=body if body is not None else [],
        headers=headers or {},
    )



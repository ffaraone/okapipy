def test_client_wraps_default_transport_when_retries_given(base_url: str) -> None:
    """Passing only `retries` builds a `RetryTransport` around the default httpx transport."""
    client = {{ client_class }}(base_url, retries=RetryPolicy(total=2))
    try:
        assert isinstance(client._http._transport, RetryTransport)
    finally:
        client.close()


def test_client_wraps_user_transport_when_both_given(base_url: str) -> None:
    """Passing `transport` and `retries` together wraps the user transport in `RetryTransport`."""
    user_transport = httpx.HTTPTransport()
    client = {{ client_class }}(
        base_url,
        transport=user_transport,
        retries=RetryPolicy(total=1),
    )
    try:
        transport = client._http._transport
        assert isinstance(transport, RetryTransport)
        assert transport.wrapped is user_transport
    finally:
        client.close()



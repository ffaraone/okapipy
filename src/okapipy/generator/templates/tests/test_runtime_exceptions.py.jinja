"""Generated by okapipy — tests for the vendored exception hierarchy.

Exercises `ApiError.__init__` and confirms every concrete subclass exists in
the hierarchy. The runtime is copied verbatim into every generated client, so
these tests pin the same behavior here as in okapipy's own suite. Emitted
once and never overwritten.
"""

from __future__ import annotations

import pytest

from {{ package }}.base.exceptions import (
    ApiError,
    ClientError,
    ConfigurationError,
    ResponseValidationError,
    ServerError,
    UnsupportedFilterError,
    UnsupportedFilterKeyError,
    UnsupportedPaginationError,
    UnsupportedSortError,
    UnsupportedSortFieldError,
)


def test_api_error_stores_message_and_metadata() -> None:
    """`ApiError(...)` keeps `message`, `status_code`, `request`, `response` accessible."""
    request = object()
    response = object()

    err = ApiError("boom", status_code=503, request=request, response=response)

    assert str(err) == "boom"
    assert err.status_code == 503
    assert err.request is request
    assert err.response is response


def test_api_error_defaults_kwargs_to_none() -> None:
    """Optional kwargs default to `None` so the simple `raise ApiError(msg)` works."""
    err = ApiError("boom")

    assert str(err) == "boom"
    assert err.status_code is None
    assert err.request is None
    assert err.response is None


@pytest.mark.parametrize(
    "cls",
    [
        ClientError,
        ServerError,
        ResponseValidationError,
        ConfigurationError,
        UnsupportedFilterError,
        UnsupportedSortError,
        UnsupportedPaginationError,
    ],
)
def test_concrete_subclasses_inherit_from_api_error(cls: type[ApiError]) -> None:
    """Every concrete subclass is catchable via `except ApiError`."""
    err = cls("nope", status_code=400)

    assert isinstance(err, ApiError)
    assert err.status_code == 400


def test_unsupported_filter_key_is_subclass_of_unsupported_filter() -> None:
    """`UnsupportedFilterKeyError` narrows `UnsupportedFilterError` for catch-by-base."""
    err = UnsupportedFilterKeyError("bad key")

    assert isinstance(err, UnsupportedFilterError)
    assert isinstance(err, ApiError)


def test_unsupported_sort_field_is_subclass_of_unsupported_sort() -> None:
    """`UnsupportedSortFieldError` narrows `UnsupportedSortError` for catch-by-base."""
    err = UnsupportedSortFieldError("bad field")

    assert isinstance(err, UnsupportedSortError)
    assert isinstance(err, ApiError)

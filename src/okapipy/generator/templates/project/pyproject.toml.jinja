# Generated by okapipy — edit freely.
[project]
name = "{{ project_name }}"
version = "{{ project_version }}"
description = "Generated client for {{ project_name }}"
requires-python = ">={{ python_version }},<4"
dependencies = [
    "httpx>=0.27,<1",
    "pydantic[email]>=2.6,<3",
]

[dependency-groups]
dev = [
    "mypy>=1.10,<2",
    "pytest>=8,<9",
    "pytest-asyncio>=1,<2",
    "pytest-cov>=5,<8",
    "ruff>=0.5,<1",
]

[tool.uv]
package = true

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["src/{{ top_package }}"]

[tool.pytest.ini_options]
testpaths = "tests"
pythonpath = "."
addopts = "--cov={{ package }} --cov-report=term-missing"

[tool.ruff]
line-length = 100

[tool.ruff.lint]
select = ["E", "W", "F", "I", "B", "C4", "UP"]

[tool.ruff.lint.isort]
known-first-party = ["{{ top_package }}"]

[tool.mypy]
strict = true
ignore_missing_imports = true
mypy_path = "src"
namespace_packages = true
explicit_package_bases = true

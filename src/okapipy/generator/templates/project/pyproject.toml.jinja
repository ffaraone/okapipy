# Generated by okapipy — edit freely.
[project]
name = "{{ project_name }}"
version = "{{ project_version }}"
description = "{{ project_description }}"
readme = "README.md"
requires-python = ">={{ python_version }},<4"
{% if license_is_spdx %}
license = "{{ license }}"
{% endif %}
license-files = ["LICEN[CS]E*"]
{% if author %}
authors = [
    { name = "{{ author }}" },
]
{% endif %}
dependencies = [
    "httpx>=0.27,<1",
    "pydantic[email]>=2.6,<3",
]
{% if project_urls %}

[project.urls]
{% for label, url in project_urls -%}
{{ label }} = "{{ url }}"
{% endfor -%}
{% endif %}

[dependency-groups]
dev = [
    "mypy>=1.10,<2",
    "pytest>=8,<9",
    "pytest-asyncio>=1,<2",
    "pytest-cov>=5,<8",
    "pytest-httpx>=0.30,<1",
    "pytest-mock>=3.14,<4",
    "ruff>=0.5,<1",
]

[tool.uv]
package = true

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["src/{{ top_package }}"]

[tool.pytest.ini_options]
testpaths = "tests"
pythonpath = "."
addopts = "--cov={{ package }} --cov-report=term-missing"
asyncio_mode = "strict"

[tool.ruff]
line-length = 100

[tool.ruff.lint]
select = ["E", "W", "F", "I", "B", "C4", "UP"]

[tool.ruff.lint.isort]
known-first-party = ["{{ top_package }}"]

[tool.mypy]
strict = true
ignore_missing_imports = true
mypy_path = "src"
namespace_packages = true
explicit_package_bases = true
